# Token bota Telegram (od @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAF_twój_token_tutaj

# Chat ID — jak znaleźć: napisz do @userinfobot w Telegram
TELEGRAM_CHAT_ID=-100123456789

# Token API z Baselinker (Moje konto → API)
BASELINKER_TOKEN=twój_token_baselinker

# Strefa czasowa
TIMEZONE=Europe/Warsaw

# Co ile sekund sprawdzać (domyślnie 120 = 2 minuty)
POLL_INTERVAL=120
